# --- Ingest protection (REQUIRED) ---
# Shared secret guarding every API route. The app fails closed: if this is
# unset, all requests are refused rather than served openly.
# Generate one with:  openssl rand -base64 32
# Send it as `x-capture-token: <value>` (or `Authorization: Bearer <value>`).
CAPTURE_TOKEN=

# --- Supabase (server-side only) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key (NOT the anon key). Server-only — never exposed to the
# browser. It bypasses RLS, so CAPTURE_TOKEN is the real access control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (auto-tagging + summary) ---
ANTHROPIC_API_KEY=

# --- Voyage AI (embeddings) ---
# https://www.voyageai.com — voyage-3.5 emits 1024-dim vectors (matches schema)
VOYAGE_API_KEY=

# --- Optional tuning ---
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# VOYAGE_MODEL=voyage-3.5
# Per-call budget for tagging/embedding. Exceeding it degrades to an untagged
# save rather than failing the capture.
# ENRICH_TIMEOUT_MS=9000
# MAX_BODY_CHARS=20000
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SEC=60
# Identical bodies captured inside this window collapse into one entry.
# DEDUPE_WINDOW_SEC=300
