# --- Supabase (server-side only) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key (NOT the anon key). Server-only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (auto-tagging + summary) ---
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Voyage AI (embeddings) ---
# https://www.voyageai.com — voyage-3.5 outputs 1024-dim vectors (matches schema)
VOYAGE_API_KEY=
# Optional; defaults to voyage-3.5
VOYAGE_MODEL=voyage-3.5

# --- Ingest protection (optional but recommended) ---
# If set, POST /api/entries requires this as a Bearer token or x-ingest-secret
# header. Put the same value in your Apple Shortcut's request headers.
INGEST_SECRET=
